# ---- Server ----
PORT=3000
NODE_ENV=production
# Public URL of your deployed app (used to build QR codes). No trailing slash.
# Locally this can be http://localhost:3000
BASE_URL=https://your-app-name.onrender.com

# ---- Session ----
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# ---- Admin login (single admin account) ----
ADMIN_USERNAME=admin
# Generate this with: npm run hash-password  (then paste the output hash below)
ADMIN_PASSWORD_HASH=

# ---- Google Sheets ----
# The ID of your Google Sheet (from its URL: https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit)
GOOGLE_SHEET_ID=

# ---- Google Drive (stores full-quality item photos) ----
# The ID of your Drive folder (from its URL: https://drive.google.com/drive/folders/THIS_PART_HERE)
GOOGLE_DRIVE_FOLDER_ID=

# Service account credentials (from the JSON key file Google Cloud gives you)
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the \n characters literally - do not replace them with real line breaks
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
